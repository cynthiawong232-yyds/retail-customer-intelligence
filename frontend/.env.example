# Copy to .env.local for development, and set the same key in Vercel's
# project settings for production.
#
# Vite only exposes variables prefixed with VITE_ to the browser. That prefix
# is a safety rail, not a naming convention: anything exposed here ends up in
# the shipped bundle and is readable by anyone. Never put a secret in this
# file. This API is a public read-only demo, so its URL is not one.
VITE_API_URL=http://localhost:8000
