# Data is downloaded by code, never committed.
# Keeps the repo small and proves the pipeline is reproducible from scratch.
data/raw/
data/processed/

# Trained model artifacts.
#
# These ARE committed, deliberately, because the serving bundle is 1.87 MB and
# the deployed container needs it at build time. For a bigger model the right
# answer is a model registry or object storage, and git would be the wrong
# place. At this size, committing keeps deployment to one command and lets
# anyone clone and serve without retraining.
#
# Anything large or intermediate still stays out:
artifacts/*.csv
artifacts/*.parquet

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environments (this project's venv lives at C:\venvs\rci, outside OneDrive)
.venv/
venv/
.env

# Frontend
frontend/node_modules/
frontend/dist/
# Vite inlines VITE_* vars into the shipped bundle, so .env.local is a build
# input rather than a runtime secret store. Ignored anyway: the API URL differs
# per machine, and nothing that ends up in a public bundle belongs in git.
frontend/.env.local
frontend/.env.*.local
